<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gproxyt\Gproxyt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Gproxyt\MainWindow.xaml"
             Link="MainWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Gproxyt\SettingsWindow.xaml"
             Link="SettingsWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Gproxyt\Resources\Strings.*.json"
             Link="Resources\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
